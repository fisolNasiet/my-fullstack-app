pipeline {
    agent any

    environment {
        FRONTEND_IMAGE = "myapp-frontend:latest"
        BACKEND_IMAGE = "myapp-backend:latest"
    }

    stages {
      
        stage('Build Package (Maven)') {
            steps {
                dir('backend') {
                    sh "mvn clean package -DskipTests"
                }
            }
        }

        stage('Build Frontend Assets (npm)') {
            steps {
                dir('frontend') {
                    // Downloads your JavaScript libraries
                    sh "npm ci"
                    // Compiles the React code into the build/ or dist/ folder
                    sh "npm run build"
                }
            }
        }

        stage('Build Backend Docker Image') {
            steps {
                dir('backend') {
                    sh "docker build -t ${BACKEND_IMAGE} ."
                }
            }
        }

        stage('Build Frontend Docker Image') {
            steps {
                dir('frontend') {
                    sh "docker build -t ${FRONTEND_IMAGE} ."
                }
            }
        }

        // --- DEPLOYMENT STAGE ---
        stage('Deploy to Kubernetes') {
            steps {
                dir('k8s') {
                    sh "kubectl apply -f postgres-deployment.yaml"
                    sh "kubectl apply -f backend-deployment.yaml"
                    sh "kubectl apply -f frontend-deployment.yaml"
                    sh "kubectl apply -f ingress.yaml"
                }
            }
        }
    }
}